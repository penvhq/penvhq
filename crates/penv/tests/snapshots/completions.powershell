        'penv;gen' {
            [CompletionResult]::new('--out', '--out', [CompletionResultType]::ParameterValue, 'Write here instead, relative to the repository root')
            [CompletionResult]::new('--check', '--check', [CompletionResultType]::ParameterValue, 'Compare with what is on disk instead of writing')
            [CompletionResult]::new('--options', '--options', [CompletionResultType]::ParameterValue, 'Show what this target''s options change instead of writing')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterValue, 'Emit JSON on stdout, whatever stdout is attached to')
            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterValue, 'Pick the output format: json or text')
            [CompletionResult]::new('--agent', '--agent', [CompletionResultType]::ParameterValue, 'Treat this session as an agent: JSON out, values masked')
            [CompletionResult]::new('--provider', '--provider', [CompletionResultType]::ParameterValue, 'Read values from this provider instead of the one @penv= names')
            break
        }
        'penv;scan' {
            [CompletionResult]::new('--staged', '--staged', [CompletionResultType]::ParameterValue, 'Scan only what is staged for the next commit')
            [CompletionResult]::new('--install-hook', '--install-hook', [CompletionResultType]::ParameterValue, 'Write a git pre-commit hook that runs penv scan --staged')
            [CompletionResult]::new('--env', '--env', [CompletionResultType]::ParameterValue, 'The environment whose values to look for')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterValue, 'Emit JSON on stdout, whatever stdout is attached to')
            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterValue, 'Pick the output format: json or text')
            [CompletionResult]::new('--agent', '--agent', [CompletionResultType]::ParameterValue, 'Treat this session as an agent: JSON out, values masked')
            [CompletionResult]::new('--provider', '--provider', [CompletionResultType]::ParameterValue, 'Read values from this provider instead of the one @penv= names')
            break
        }
        'penv;guard' {
            [CompletionResult]::new('--all', '--all', [CompletionResultType]::ParameterValue, 'Write every harness penv knows, installed or not')
            [CompletionResult]::new('--check', '--check', [CompletionResultType]::ParameterValue, 'Report coverage instead of writing')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterValue, 'Emit JSON on stdout, whatever stdout is attached to')
            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterValue, 'Pick the output format: json or text')
            [CompletionResult]::new('--agent', '--agent', [CompletionResultType]::ParameterValue, 'Treat this session as an agent: JSON out, values masked')
            [CompletionResult]::new('--provider', '--provider', [CompletionResultType]::ParameterValue, 'Read values from this provider instead of the one @penv= names')
            break
        }
        'penv;reveal' {
            [CompletionResult]::new('--env', '--env', [CompletionResultType]::ParameterValue, 'The environment to read')
            [CompletionResult]::new('--approval', '--approval', [CompletionResultType]::ParameterValue, 'Print the value a person approved under this id')
            [CompletionResult]::new('--json', '--json', [CompletionResultType]::ParameterValue, 'Emit JSON on stdout, whatever stdout is attached to')
            [CompletionResult]::new('--format', '--format', [CompletionResultType]::ParameterValue, 'Pick the output format: json or text')
            [CompletionResult]::new('--agent', '--agent', [CompletionResultType]::ParameterValue, 'Treat this session as an agent: JSON out, values masked')
            [CompletionResult]::new('--provider', '--provider', [CompletionResultType]::ParameterValue, 'Read values from this provider instead of the one @penv= names')
            break
        }
        'penv;project' {
            [CompletionResult]::new('ls', 'ls', [CompletionResultType]::ParameterValue, 'List your projects and their environments')
            [CompletionResult]::new('new', 'new', [CompletionResultType]::ParameterValue, 'Create a project with a development environment')
            [CompletionResult]::new('rename', 'rename', [CompletionResultType]::ParameterValue, 'Rename a project; a folder linked to it is updated too')
