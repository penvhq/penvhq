# penv completions elvish
use builtin;
use str;

set edit:completion:arg-completer[penv] = {|@words|
    fn cand {|text desc|
        edit:complex-candidate $text &display=$text' '$desc
    }
    var valued = [&'--format'=['json' 'text'] &'--guards'=[] &'--output'=[] &'--env'=[] &'--org'=[] &'--value'=[] &'--out'=[] &'--approval'=[]]
    var previous = ''
    if (> (count $words) 1) { set previous = $words[-2] }
    var command = 'penv'
    var skip = $false
    for word $words[1..-1] {
        if $skip { set skip = $false; continue }
        if (str:has-prefix $word '-') {
            if (has-key $valued $word) { set skip = $true }
            continue
        }
        set command = $command';'$word
    }
    if (has-key $valued $previous) {
        for value $valued[$previous] { cand $value $value }
    } else {
        if (eq $command 'penv') {
            cand 'init' 'Read .env, write .env.schema, and keep .env out of the repository'
            cand 'run' 'Run a command with your secrets loaded into it'
            cand 'push' 'Move local values to the cloud and delete .env'
            cand 'pull' 'Write a plain .env from the cloud'
            cand 'login' 'Sign in through your browser; the login is kept in your system''s password store'
            cand 'logout' 'Sign out on this machine'
            cand 'set' 'Save one value (typed hidden, never shown)'
            cand 'unset' 'Delete one value'
            cand 'ls' 'List your keys and show which ones have a value'
            cand 'check' 'Report schema problems and missing values'
            cand 'gen' 'Write the typed file for your language (ts, py)'
            cand 'scan' 'Find secret values committed to files'
            cand 'guard' 'Write the harness rules that keep agents out of .env'
            cand 'reveal' 'Show one value; an AI agent needs your approval first'
            cand 'project' 'Your projects: ls, new, rename, rm'
            cand 'env' 'A project''s environments: ls, new, rename, copy, rm'
            cand 'machine' 'Identities for servers and CI'
            cand 'upgrade' 'Replace penv with the latest release'
            cand 'completions' 'Print the shell completion script'
            cand 'hook' 'Run as a harness hook; a payload it cannot read is refused'
            cand 'schema' 'Print the schema as JSON'
            cand 'help' 'Show help for a command'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;init') {
            cand '--force' 'Overwrite an existing .env.schema'
            cand '--guards' 'Guard exactly these harnesses instead of the installed ones'
            cand '--no-guards' 'Write no harness rules at all'
            cand '--output' 'Write the generated typed file here, relative to the repository root'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;run') {
            cand '--env' 'The environment to read'
            cand '--no-mask' 'Show secrets in the command''s output instead of hiding them'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;push') {
            cand '--env' 'The environment to write to'
            cand '--org' 'The organisation that owns a project penv is about to create'
            cand '--prune' 'Delete cloud keys the schema no longer lists'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;pull') {
            cand '--env' 'The environment to read'
            cand '--i-am-human' 'Confirm a person, not an agent, asked for the file'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;login') {
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;logout') {
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;set') {
            cand '--env' 'The environment to write to'
            cand '--value' 'Refused: a value passed here lands in the shell history'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;unset') {
            cand '--env' 'The environment to write to'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;ls') {
            cand '--env' 'The environment to read'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;check') {
            cand '--env' 'The environment to check'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;gen') {
            cand '--out' 'Write here instead, relative to the repository root'
            cand '--check' 'Compare with what is on disk instead of writing'
            cand '--options' 'Show what this target''s options change instead of writing'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;scan') {
            cand '--staged' 'Scan only what is staged for the next commit'
            cand '--install-hook' 'Write a git pre-commit hook that runs penv scan --staged'
            cand '--env' 'The environment whose values to look for'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;guard') {
            cand '--all' 'Write every harness penv knows, installed or not'
            cand '--check' 'Report coverage instead of writing'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;reveal') {
            cand '--env' 'The environment to read'
            cand '--approval' 'Print the value a person approved under this id'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;project') {
            cand 'ls' 'List your projects and their environments'
            cand 'new' 'Create a project with a development environment'
            cand 'rename' 'Rename a project; a folder linked to it is updated too'
            cand 'rm' 'Delete a project and every value in it, for good'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;project;ls') {
            cand '--org' 'Only this organisation'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;project;new') {
            cand '--org' 'The organisation that owns it'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;project;rename') {
            cand '--org' ''
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;project;rm') {
            cand '--org' ''
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;env') {
            cand 'ls' 'List the project''s environments'
            cand 'new' 'Create an empty environment'
            cand 'rename' 'Rename an environment'
            cand 'copy' 'Create an environment with another one''s keys; values are never copied'
            cand 'rm' 'Delete an environment and every value in it, for good'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;env;ls') {
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;env;new') {
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;env;rename') {
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;env;copy') {
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;env;rm') {
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;machine') {
            cand 'enroll' 'Give this server its own identity, from a one-time secret made in the console'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;machine;enroll') {
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;upgrade') {
            cand '--check' 'Only report what the latest release is'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;completions') {
            cand 'bash' 'bash'
            cand 'zsh' 'zsh'
            cand 'fish' 'fish'
            cand 'powershell' 'powershell'
            cand 'elvish' 'elvish'
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;hook') {
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;schema') {
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
        if (eq $command 'penv;help') {
            cand '--json' 'Emit JSON on stdout, whatever stdout is attached to'
            cand '--format' 'Pick the output format: json or text'
            cand '--agent' 'Treat this session as an agent: JSON out, values masked'
        }
    }
}
