{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.*)", "Read(~/.config/penv/local.key)"]
  },
  "sandbox": {
    "filesystem": {
      "denyRead": ["./.env", "./.env.*", "~/.config/penv/local.key"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [{ "type": "command", "command": "penv hook claude-code" }]
      }
    ]
  }
}
