        if ({{ v }}Raw != null) {
            try {
                int n = Integer.parseInt({{ v }}Raw.trim());
                if (n >= 1 && n <= 65535) {
                    {{ v }} = n;
                } else {
                    problems.add({{ key.name | quote }} + " is not a port");
                }
            } catch (NumberFormatException e) {
                problems.add({{ key.name | quote }} + " is not a port");
            }
        }
{%- elif ty == "number" and key.lang_type == "long" %}
        Long {{ v }} = null;
        if ({{ v }}Raw != null) {
            try {
                {{ v }} = Long.parseLong({{ v }}Raw.trim());
            } catch (NumberFormatException e) {
                problems.add({{ key.name | quote }} + " is not an integer");
            }
        }
{%- elif ty == "number" %}
        Double {{ v }} = null;
        if ({{ v }}Raw != null) {
            try {
                {{ v }} = Double.parseDouble({{ v }}Raw.trim());
            } catch (NumberFormatException e) {
                problems.add({{ key.name | quote }} + " is not a number");
            }
        }
{%- elif ty == "boolean" %}
        Boolean {{ v }} = {{ v }}Raw == null ? null : flag({{ v }}Raw);
        if ({{ v }}Raw != null && {{ v }} == null) {
            problems.add({{ key.name | quote }} + " is not a boolean");
