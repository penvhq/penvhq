package {{ options.package | default("config") }};

import java.util.ArrayList;
import java.util.List;
import java.util.Set;

/** Every variable .env.schema declares. {@code Env.load()} reads and checks them. */
public record Env(
{%- for key in keys %}
{%- if key.description %}
        /* {{ key.description | java_comment }} */
{%- endif %}
        {{ jtype(key) }} {{ id(key) }}{% if not loop.last %},{% endif %}
{%- endfor %}) {

    /** A value that prints as [redacted]; {@code expose()} returns it. */
    public static final class Secret {
        private final String value;

        public Secret(String value) {
            this.value = value;
        }

        public String expose() {
            return value;
        }

        @Override
        public String toString() {
            return "[redacted]";
        }
    }

    private static String raw(String name, String fallback, boolean required, List<String> problems) {
        String value = System.getenv(name);
        if (value == null || value.isEmpty()) {
            value = fallback;
        }
        if (value == null || value.isEmpty()) {
            if (required) {
                problems.add(name + " is not set; run penv check");
            }
            return null;
        }
        return value;
    }

    private static Boolean flag(String value) {
        switch (value.trim().toLowerCase()) {
            case "1": case "true": case "yes": case "on": return Boolean.TRUE;
            case "0": case "false": case "no": case "off": return Boolean.FALSE;
            default: return null;
        }
    }

    /** Read and check every variable. The exception names each problem, never a value. */
    public static Env load() {
        List<String> __penvProblems = new ArrayList<>();
{%- for key in keys %}
{%- set v = id(key) %}
{%- set r = "__penvRaw_" ~ (key.name | camel) %}
{%- set ty = key.type.name %}
{%- set def = key.default | default("", true) %}
        String {{ r }} = raw({{ key.name | quote }}, {{ def | quote }}, {{ "true" if key.required else "false" }}, __penvProblems);
{%- if ty == "port" %}
        Integer {{ v }} = null;
        if ({{ r }} != null) {
            try {
                int __penvN = Integer.parseInt({{ r }}.trim());
                if (__penvN >= 1 && __penvN <= 65535) {
                    {{ v }} = __penvN;
                } else {
                    __penvProblems.add({{ key.name | quote }} + " is not a port");
                }
            } catch (NumberFormatException __penvE) {
                __penvProblems.add({{ key.name | quote }} + " is not a port");
            }
        }
{%- elif ty == "number" and key.lang_type == "long" %}
        Long {{ v }} = null;
        if ({{ r }} != null) {
            try {
                {{ v }} = Long.parseLong({{ r }}.trim());
            } catch (NumberFormatException __penvE) {
                __penvProblems.add({{ key.name | quote }} + " is not an integer");
            }
        }
{%- elif ty == "number" %}
        Double {{ v }} = null;
        if ({{ r }} != null) {
            try {
                {{ v }} = Double.parseDouble({{ r }}.trim());
            } catch (NumberFormatException __penvE) {
                __penvProblems.add({{ key.name | quote }} + " is not a number");
            }
        }
{%- elif ty == "boolean" %}
        Boolean {{ v }} = {{ r }} == null ? null : flag({{ r }});
        if ({{ r }} != null && {{ v }} == null) {
            __penvProblems.add({{ key.name | quote }} + " is not a boolean");
        }
{%- elif ty == "enum" %}
        String {{ v }} = {{ r }};
        if ({{ v }} != null && !Set.of({% for m in key.type.members %}{{ m | quote }}{% if not loop.last %}, {% endif %}{% endfor %}).contains({{ v }})) {
            __penvProblems.add({{ (key.name ~ " is not one of " ~ (key.type.members | join(", "))) | quote }});
            {{ v }} = null;
        }
{%- elif jtype(key) == "Secret" %}
        Secret {{ v }} = {{ r }} == null ? null : new Secret({{ r }});
{%- else %}
        String {{ v }} = {{ r }};
{%- endif %}
{%- endfor %}
        if (!__penvProblems.isEmpty()) {
            throw new IllegalStateException(String.join("; ", __penvProblems));
        }
        return new Env(
{%- for key in keys %}
                {{ id(key) }}{% if not loop.last %},{% endif %}
{%- endfor %});
    }
}
