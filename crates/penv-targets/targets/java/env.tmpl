        if ({{ v }} != null && !Set.of({% for m in key.type.members %}{{ m | quote }}{% if not loop.last %}, {% endif %}{% endfor %}).contains({{ v }})) {
            problems.add({{ key.name | quote }} + " is not one of {{ key.type.members | join(', ') }}");
            {{ v }} = null;
        }
{%- elif jtype(key) == "Secret" %}
        Secret {{ v }} = {{ v }}Raw == null ? null : new Secret({{ v }}Raw);
{%- else %}
        String {{ v }} = {{ v }}Raw;
{%- endif %}
{%- endfor %}
        if (!problems.isEmpty()) {
            throw new IllegalStateException(String.join("; ", problems));
