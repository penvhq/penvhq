{%- set runtime = options.runtime if options.runtime is defined else "node" -%}
{%- macro prop(key) -%}
{%- if options.key_case is defined and options.key_case == "camel" -%}
{{ key.name | camel }}
{%- else -%}
{{ key.name }}
{%- endif -%}
{%- endmacro -%}
{#- Public keys are read by their literal name, the only form a bundler inlines.
    Server keys go through read(), a computed lookup no bundler inlines, so a
    secret's value can never be written into client code. -#}
{%- macro at(key) -%}
{%- if key.public is defined and key.public -%}
{%- if runtime == "vite" -%}
inlined(() => import.meta.env.{{ key.name }}, {{ key.name | quote }})
{%- elif runtime == "deno" -%}
Deno.env.get({{ key.name | quote }})
{%- elif runtime == "workers" -%}
read({{ key.name | quote }})
{%- else -%}
inlined(() => process.env.{{ key.name }}, {{ key.name | quote }})
{%- endif -%}
{%- else -%}
read({{ key.name | quote }})
{%- endif -%}
{%- endmacro -%}
{%- macro value(key) -%}
{%- if key.type.name in ["number", "port"] -%}
{%- if key.default is none -%}
{%- if key.required -%}
Number({{ at(key) }})
{%- else -%}
{{ at(key) }} === undefined ? undefined : Number({{ at(key) }})
{%- endif -%}
{%- else -%}
Number({{ at(key) }} ?? {{ key.default | quote }})
{%- endif -%}
{%- elif key.type.name == "boolean" -%}
{%- if key.default is none -%}
{%- if key.required -%}
{{ at(key) }} === "true"
{%- else -%}
{{ at(key) }} === undefined ? undefined : {{ at(key) }} === "true"
{%- endif -%}
{%- else -%}
({{ at(key) }} ?? {{ key.default | quote }}) === "true"
{%- endif -%}
{%- elif key.default is none -%}
{{ at(key) }} as {{ key.lang_type }}{% if not key.required %} | undefined{% endif %}
{%- else -%}
({{ at(key) }} ?? {{ key.default | quote }}) as {{ key.lang_type }}
{%- endif -%}
{%- endmacro -%}
{#- envSchema validates the record the runtime reads, so it keys on the
    environment name and only emits the checks this schema needs. -#}
{%- set used = keys | map(attribute="type.name") | list -%}
{%- set checked = "number" in used or "port" in used or "boolean" in used or "url" in used or "email" in used -%}
{%- set rules = {"number": "must be a number", "integer": "must be a whole number", "port": "must be a port between 1 and 65535", "boolean": "must be true or false", "url": "must be a url", "email": "must be an email address"} -%}
// Generated by penv {{ penv.version }} from .env.schema. Do not edit.
{% if runtime == "workers" %}
import { env as bindings } from "cloudflare:workers";

const read = (name: string): string | undefined => {
  const value = (bindings as Record<string, unknown>)[name];
  return typeof value === "string" ? value : undefined;
};
{%- elif runtime == "deno" %}
const read = (name: string): string | undefined => Deno.env.get(name);
{%- else %}
// Server keys are read here, by computed name, never as process.env.NAME: a
// bundler inlines only the literal form, so no build can copy these values into
// client code. In a runtime with no server environment (a browser) it throws.
const read = (name: string): string | undefined => {
  const g = globalThis as {
    process?: { env?: Record<string, string | undefined> };
    Deno?: { env: { get(name: string): string | undefined } };
    Netlify?: { env: { get(name: string): string | undefined } };
  };
  if (g.process?.env) return g.process.env[name];
  if (g.Deno?.env) return g.Deno.env.get(name);
  if (g.Netlify?.env) return g.Netlify.env.get(name);
  throw new Error(`${name} is server-only, and this runtime has no server environment.`);
};

// Public keys are written as a literal the bundler replaces. Where nothing
// replaced it and the runtime has no process global (an edge runtime, a Worker), the
// literal would throw, so the key is read the computed way, or is undefined.
const inlined = (literal: () => string | undefined, name: string): string | undefined => {
  try {
    const value = literal();
    if (value !== undefined) return value;
  } catch {
    // no process global here
  }
  try {
    return read(name);
  } catch {
    return undefined;
  }
};
{%- endif %}

export const env = {
{%- for key in keys %}
{%- if key.description %}
  /** {{ key.description }} */
{%- endif %}
  get {{ prop(key) }}() {
    return {{ value(key) }};
  },
{%- endfor %}
};

export type Env = typeof env;

export const envSchema = {
  "~standard": {
    version: 1,
    vendor: "penv",
    validate: (input: unknown) => {
      const seen = (input ?? {}) as Record<string, unknown>;
      const issues: { message: string; path: [string] }[] = [];
{%- if checked %}
      const is = {
{%- if "number" in used %}
        number: (v: string) => Number.isFinite(Number(v)),
        integer: (v: string) => Number.isInteger(Number(v)),
{%- endif %}
{%- if "port" in used %}
        port: (v: string) => Number.isInteger(Number(v)) && Number(v) >= 1 && Number(v) <= 65535,
{%- endif %}
{%- if "boolean" in used %}
        boolean: (v: string) => v === "true" || v === "false",
{%- endif %}
{%- if "url" in used %}
        url: (v: string) => { try { new URL(v); return true; } catch { return false; } },
{%- endif %}
{%- if "email" in used %}
        email: (v: string) => { const at = v.indexOf("@"); return at > 0 && at < v.length - 1 && at === v.lastIndexOf("@"); },
{%- endif %}
      };
{%- endif %}
{%- for key in keys %}
{%- set found = "seen[" ~ (key.name | quote) ~ "]" %}
{%- set path = "path: [" ~ (key.name | quote) ~ "]" %}
{%- set kind = "integer" if (key.type.name == "number" and key.type.constraints.isInt is defined) else key.type.name %}
{%- if key.required %}
      if ({{ found }} === undefined || {{ found }} === "") {
        issues.push({ message: {{ (key.name ~ " is required") | quote }}, {{ path }} });
      }
{%- endif %}
{%- if kind == "enum" %}
      if ({{ found }} !== undefined && {{ found }} !== "" && !{{ key.type.members | json }}.includes(String({{ found }}))) {
        issues.push({ message: {{ (key.name ~ " must be one of " ~ (key.type.members | join(", "))) | quote }}, {{ path }} });
      }
{%- elif kind != "string" %}
      if ({{ found }} !== undefined && {{ found }} !== "" && !is.{{ kind }}(String({{ found }}))) {
        issues.push({ message: {{ (key.name ~ " " ~ rules[kind]) | quote }}, {{ path }} });
      }
{%- endif %}
{%- endfor %}
      return issues.length > 0 ? { issues } : { value: env };
    },
  },
} as const;