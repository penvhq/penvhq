# @penv=acme/api-gateway

# Where the service keeps its own rows.
# @type=url
DATABASE_URL=

# @type=string(startsWith=sk_) @rotate=90d
STRIPE_SECRET_KEY=

# Where the browser is sent back to after a redirect.
# @type=url @sensitive=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# @type=port
PORT=3000

# @type=enum(development,staging,production)
NODE_ENV=development

# The tier this deployment serves.
# @type=enum(free,pro,enterprise) @sensitive=false
PLAN_TIER=

# How long a cached value stays fresh.
# @type=number @sensitive=false
CACHE_TTL_SECONDS=1.5

# @type=number(isInt=true) @sensitive=false
MAX_RETRIES=

# @type=boolean @sensitive=false
FEATURE_BILLING=false

# @type=boolean
DEBUG_TRACING=

# Where failures are mailed.
# @type=email @sensitive=false @optional
ALERTS_EMAIL=ops@example.test

# @type=string @optional
SUPPORT_NOTE=

# Built from the secret, so its prefix does not make it safe to inline.
# @type=string @sensitive=false
NEXT_PUBLIC_CHECKOUT_TOKEN=${STRIPE_SECRET_KEY}
